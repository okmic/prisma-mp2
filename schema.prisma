// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TariffStatus {
  PREMIUM
  FREE
}

model User {
  id                      Int              @id @default(autoincrement()) @unique
  createdAt               DateTime         @default(now())
  adminTgChatId           String           @unique() 
  isDisabled              Boolean          @default(false)
  TariffStatus            TariffStatus     @default(FREE)

  parentId                Int?             @unique
  parentUser              User?            @relation("User Children", fields: [parentId], references: [id])
  childUsers              User[]           @relation("User Children")
  site                    Site[]           @relation("User Sites")
  ftpServers              FtpServer[]      @relation("User FTP SERVER")

  @@index([adminTgChatId])
}

enum SiteType {
  EJS
}

model Site {
  id                       Int          @id @default(autoincrement()) @unique
  createdAt                DateTime     @default(now())
  Type                     SiteType     @default(EJS)
  pegesStringArray         Json?        
  userId                   Int
  user                     User         @relation("User Sites", fields: [userId], references: [id])
  contentId                Int 
  content                  Content[]    @relation("Site Content")
}

model FtpServer {
  id                       Int      @id @default(autoincrement()) @unique
  createdAt                DateTime @default(now())

  ftpHost                  String
  ftpUser                  String
  ftpPassword              String
  isSecureFtp              Boolean  @default(false)

  userId                   Int     
  user                     User     @relation("User FTP SERVER", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contentId                Int     
}

model Content {
  id                       Int              @id @default(autoincrement()) @unique
  createdAt                DateTime         @default(now())
  siteId                   Int     
  site                     Site             @relation("Site Content", fields: [siteId], references: [id])
  logoName                 String           @default("MicoPage")
  logoImgUrl               String           @default("/media/icons/default-logo.png")
  companyDescription       String           @default("Mico Page - мы занимается предоставлением высококачественных услуг в области... Мы стремимся к инновациям и качеству")
  address                  String
  phone                    String
  email                    String
  mainBlockTitle           String           @default("Mico Page 👋")
  mainBlockDescription     String           @default("Choose a template and make a website")
  mainBlockImgUrl          String           @default("/media/icons/default.png")
  services                 ContentService[]
  works                    ContentWork[]
  socialMedia              ContentSocialMedia[]
  products                 SiteProducts[]

  @@index([siteId])
}

model Visit {
  id                  Int      @id @default(autoincrement()) @unique
  createdAt           DateTime @default(now())
  json                Json?
}

model ContentService {
  id        Int      @id @default(autoincrement())
  title     String
  items     ContentItem[] 
  imgUrl    String   @default("/media/icons/default.png")
  contentId Int      
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model ContentWork {
  id        Int      @id @default(autoincrement())
  title     String
  contentId Int
  imgUrl    String   @default("/media/icons/default.png")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model ContentItem {
  id        Int      @id @default(autoincrement())
  text      String   
  serviceId Int?     
  service   ContentService? @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model ContentSocialMedia {
  id            Int      @id @default(autoincrement())
  contentId     Int
  title         String   @default("MicoPage")
  linkToSM      String   @default("https://github.com/okmic")      
  imgUrl        String   @default("/media/icons/whatsapp.png")
  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model SiteProducts {
  id            Int      @id @default(autoincrement())
  title         String   @default("MicoPage")
  imgUrl        String   @default("/media/icons/default.png")
  description   String   @db.LongText()
  price         Int
  contentId     Int      
  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}